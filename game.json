  ],
  "customHelp": "You can learn the rules here https://kayoumylittleponycardgame.miraheze.org/wiki/Rules_my_little_pony_card_game or at https://ponyrec.net/rules\n- To reveal a Plan card, put your mouse over a plan card and click the flip icon on the top right corner.\n- To move your Main Character forward, click the arrow buttons.\n- To flip a Scene, click the icon at the top left corner.\n- Counters are available next to each Adventure area to keep track of your total inspiration.\n\nFan made mod. All rights reserved to Kayou and Hasbro. Defaults playmat by SambaNeko.",
  "cards": {
    "dataUrl": "https://valcur.github.io/TCG-Arena-MLP/cards.json",
    "cardBack": "https://valcur.github.io/TCG-Arena-MLP/images/back.jpg",
    "cardBackColor": "#a6a4d6"
  }
}

                        {
                            "drawFromTop": "deck",
                            "count": 1,
                            "destination": "Plan4",
                            "overrideState": {
                                "isTapped": true
                            }
                        },
                        {
                            "drawFromTop": "SceneDeck",
                            "count": 1,
                            "destination": "Mana",
                            "overrideState": {
                                "isHidden": "yes"
                            }
